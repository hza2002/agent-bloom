---
const { lang } = Astro.props;
---
<button hidden type="button" class="appearance-button" data-appearance-toggle data-light-label={lang === 'zh' ? '切换为浅色' : 'Switch to light'} data-dark-label={lang === 'zh' ? '切换为深色' : 'Switch to dark'} aria-label={lang === 'zh' ? '切换明暗外观' : 'Change appearance'}>
  <svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
  <svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg>
</button>
<script>import '../scripts/appearance';</script>
