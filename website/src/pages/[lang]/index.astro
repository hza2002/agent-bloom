---
import Layout from '../../layouts/Layout.astro';
import AgentInstall from '../../components/AgentInstall.astro';
import TerminalPreview from '../../components/TerminalPreview.astro';
import ThemeImage from '../../components/ThemeImage.astro';
import installation from '../../../public/generated/installation.json';
import { catalogue, copy, locales, url, type Locale } from '../../lib/site';
export const getStaticPaths = () => locales.map(lang => ({params: {lang}}));
const lang = Astro.params.lang as Locale;
const t = copy[lang];
const theme = catalogue.themes.find(item => item.id === catalogue.defaultTheme)!;
const previewFor = (item: typeof theme, mode: string) => item.previews[`${item.animations[0].id}/${item.apps[0]}/${mode}` as keyof typeof item.previews];
---
<Layout lang={lang} showcase>
  <div data-showcase data-catalogue={JSON.stringify(catalogue)} data-media={url('generated/media/')} data-lang={lang}>
    <section class="opening">
      <h1>{lang === 'zh' ? '给终端，一个新的开场。' : 'A new opening for your terminal.'}</h1>
      <p>{lang === 'zh' ? '为 Claude Code 和 Codex CLI 换上你喜欢的主题。' : 'Find your theme for Claude Code and Codex CLI.'}</p>
    </section>
    <section aria-label={t.themes}>
      <TerminalPreview theme={theme} lang={lang} />
      <div class="selection-row">
        <div><h2 data-selected-name>{theme.name}</h2><span class="playback-message" data-status role="status" aria-live="polite"></span></div>
        <a class="primary" href="#install" data-use>{t.use} ↓</a>
      </div>
      <div class="motion-row">
        <div data-animations class="animation-choices" role="group" aria-label={t.animation}></div>
        <button type="button" data-motion class="motion-toggle" hidden>{lang === 'zh' ? '暂停动效' : 'Pause motion'}</button>
      </div>
    </section>
    <section id="themes" class="gallery" aria-label={t.themes}>
      <div class="gallery-heading"><h2>{lang === 'zh' ? '找到你的那一款。' : 'Find your favourite.'}</h2>
        {catalogue.themes.length > 8 && <label class="theme-search"><span class="sr-only">{lang === 'zh' ? '搜索主题' : 'Search themes'}</span><input type="search" data-theme-search placeholder={lang === 'zh' ? '搜索主题名称' : 'Search theme names'} /></label>}
        <span class="theme-count">{catalogue.themes.length} {lang === 'zh' ? '款主题' : 'themes'}</span>
      </div>
      <div class="theme-grid">
        {catalogue.themes.map(item => <button class="theme-choice" type="button" data-theme-id={item.id} data-search-name={`${item.name} ${item.id}`} aria-pressed={item.id === theme.id}>
          <ThemeImage light={previewFor(item, 'light').poster} dark={previewFor(item, 'dark').poster} alt="" />
          <span class="theme-copy">
            <strong>{item.name}</strong>
            <span class="theme-meta">{item.animations.length} {lang === 'zh' ? '种开场' : item.animations.length === 1 ? 'entrance' : 'entrances'}<span aria-hidden="true"> · </span>{lang === 'zh' ? '待机动效' : 'Idle motion'}</span>
          </span>
        </button>)}
      </div>
      <p hidden data-no-results class="muted" role="status">{lang === 'zh' ? '没有匹配的主题。' : 'No matching themes.'}</p>
    </section>
    <section id="install" class="inline-install">
      <div class="install-heading"><h2>{lang === 'zh' ? '把它带进你的终端。' : 'Bring it to your terminal.'}</h2><AgentInstall lang={lang} /></div>
      <p class="muted">{lang === 'zh' ? '首次安装，使用已有的 uv。已有安装或需要配置 Codex？' : 'For a first install with uv already available. Already installed, or using Codex?'} <a href={url(`${lang}/docs/get-started/`)}>{lang === 'zh' ? '查看安装指南' : 'Read the installation guide'}</a></p>
      <div class="installation-code"><pre><code id="install-command">{installation[lang]}</code></pre><div class="copy-row"><button type="button" data-copy="install-command" data-success={t.copied} data-error={t.copyError}>{lang === 'zh' ? '复制安装命令' : 'Copy install commands'}</button><span role="status" aria-live="polite"></span></div></div>
      <p class="launch-label">{lang === 'zh' ? '安装后，启动所选主题：' : 'Then launch your selected theme:'}</p>
      <pre class="launch-command"><code data-launch-command>agent-bloom --theme {theme.id} --animation {theme.animations[0].id} {theme.apps[0]}</code></pre>
      <p class="muted small">{lang === 'zh' ? '使用 Codex 时，把命令中的 claude 换成 codex，并先完成指南中的首页配置。' : 'For Codex, replace claude with codex and complete the home configuration in the guide first.'}</p>
    </section>
  </div>
  <script>import '../../scripts/player';</script>
</Layout>
