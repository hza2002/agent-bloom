---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import TerminalPreview from '../../components/TerminalPreview.astro';
import ThemeImage from '../../components/ThemeImage.astro';
import { catalogue, copy, locales, url, type Locale } from '../../lib/site';
export const getStaticPaths = () => locales.map(lang => ({params: {lang}}));
const lang = Astro.params.lang as Locale;
const t = copy[lang];
const theme = catalogue.themes.find(item => item.id === catalogue.defaultTheme)!;
const previewFor = (item: typeof theme, mode: string) => item.previews[`${item.animations[0].id}/${item.apps[0]}/${mode}` as keyof typeof item.previews];
---
<Layout lang={lang} showcase>
  <div data-showcase data-catalogue={JSON.stringify(catalogue)} data-media={url('generated/media/')} data-lang={lang}>
    <section class="opening">
      <div class="opening-title">
        <h1>{lang === 'zh' ? '让终端，更像你。' : 'Your terminal. Your opening.'}</h1>
      </div>
      <p>{lang === 'zh' ? 'Claude Code 与 Codex CLI 的主题、开场与待机动效。' : 'Themes, openings and idle motion for Claude Code and Codex CLI.'}</p>
    </section>
    <div class="showroom">
      <section class="preview-column" aria-label={lang === 'zh' ? '当前主题预览' : 'Selected theme preview'}>
        <div class="selection-row">
          <div><h2 data-selected-name>{theme.name}</h2><span class="playback-message" data-status role="status" aria-live="polite"></span></div>
          <a class="primary" href={url(`${lang}/docs/get-started/`)} data-use><Icon name="download" />{t.use}</a>
        </div>
        <TerminalPreview theme={theme} lang={lang} />
        <div class="motion-row">
          <div data-animations class="animation-choices" role="group" aria-label={t.animation}></div>
          <div class="playback-controls">
            <button type="button" data-replay class="motion-toggle" hidden><Icon name="replay" />{lang === 'zh' ? '重播开场' : 'Replay opening'}</button>
            <button type="button" data-ambient class="motion-toggle" hidden><Icon name="sparkles" />{lang === 'zh' ? '播放待机' : 'Play idle motion'}</button>
          </div>
        </div>

      </section>
      <section id="themes" class="gallery" aria-label={t.themes}>
        <div class="gallery-heading"><h2><Icon name="grid" />{lang === 'zh' ? '选择主题' : 'Choose a theme'}</h2>
          {catalogue.themes.length > 8 && <label class="theme-search"><span class="sr-only">{lang === 'zh' ? '搜索主题' : 'Search themes'}</span><Icon name="search" /><input type="search" data-theme-search placeholder={lang === 'zh' ? '搜索主题名称' : 'Search theme names'} /></label>}
          <span class="theme-count">{catalogue.themes.length} {lang === 'zh' ? '款主题' : 'themes'}</span>
        </div>
        <div class="theme-grid">
          {catalogue.themes.map(item => <button class="theme-choice" type="button" data-theme-id={item.id} data-search-name={`${item.name} ${item.id}`} aria-pressed={item.id === theme.id}>
            <ThemeImage light={previewFor(item, 'light').poster} dark={previewFor(item, 'dark').poster} alt="" />
            <span class="theme-copy">
              <strong>{item.name}</strong>
            </span>
          </button>)}
        </div>
        <p hidden data-no-results class="muted" role="status">{lang === 'zh' ? '没有匹配的主题。' : 'No matching themes.'}</p>
      </section>
    </div>

  </div>
  <script>import '../../scripts/player';</script>
</Layout>
